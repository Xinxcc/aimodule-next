{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AIModule",
  "version": "2.0.0",
  "identifier": "com.aimodule.desktop",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm --prefix ../../web run dev",
    "beforeBuildCommand": "npm --prefix ../../web run build"
  },
  "app": {
    "windows": [
      {
        "title": "AIModule",
        "width": 1280,
        "height": 860,
        "minWidth": 1100,
        "minHeight": 760
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:8756 ws://127.0.0.1:8756; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": ["icons/icon.ico"],
    "resources": [],
    "externalBin": ["binaries/aimodule-backend"]
  }
}
